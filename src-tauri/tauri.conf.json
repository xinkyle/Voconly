{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voconly",
  "identifier": "com.voconly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/*": "resources/models/"
    },
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "resources": {
        "../target/release/ggml.dll": "",
        "../target/release/ggml-base.dll": "",
        "../target/release/ggml-cpu-alderlake.dll": "",
        "../target/release/ggml-cpu-cannonlake.dll": "",
        "../target/release/ggml-cpu-cascadelake.dll": "",
        "../target/release/ggml-cpu-haswell.dll": "",
        "../target/release/ggml-cpu-icelake.dll": "",
        "../target/release/ggml-cpu-sandybridge.dll": "",
        "../target/release/ggml-cpu-skylakex.dll": "",
        "../target/release/ggml-cpu-sse42.dll": "",
        "../target/release/ggml-cpu-x64.dll": "",
        "../target/release/ggml-vulkan.dll": "",
        "../target/release/transcribe.dll": ""
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./hooks/nsis-hooks.nsh",
        "template": "nsis/installer.nsi",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMjY1MTJEN0MwMjZCNEYKUldSUGF3SjhMVkVtMEMxYmQwNGdqT0lmeEVGRFlOeWxlQWZiY28xaWZobzNpd1hkOTViVmtWRloK",
      "endpoints": [
        "https://gitee.com/xingkyle/Voconly/releases/download/v{{current_version}}/latest.json",
        "https://github.com/xinkyle/Voconly/releases/download/v{{current_version}}/latest.json"
      ]
    }
  }
}
