{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voconly",
  "identifier": "com.voconly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/*": "resources/models/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./hooks/nsis-hooks.nsh",
        "template": "nsis/installer.nsi",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMjY1MTJEN0MwMjZCNEYKUldSUGF3SjhMVkVtMEMxYmQwNGdqT0lmeEVGRFlOeWxlQWZiY28xaWZobzNpd1hkOTViVmtWRloK",
      "endpoints": [
        "https://github.com/xinkyle/Voconly/releases/latest/download/latest.json"
      ]
    }
  }
}
